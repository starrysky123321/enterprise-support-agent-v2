# Example configuration for running the knowledge index service with local Ollama
# (OpenAI-compatible API on host) + semantic embeddings.
# Usage:
#   KNOWLEDGE_PYTHON_ENV_FILE=.env.knowledge.ollama.example docker compose -f knowledge-compose.yml up -d --build index
LLM_PROVIDER=qwen
DASHSCOPE_API_KEY=ollama
DASHSCOPE_BASE_URL=http://host.docker.internal:11434/v1
DASHSCOPE_MODEL_NAME=qwen2.5:1.5b
EMBEDDING_PROVIDER=openai
OPENAI_KEY=ollama
EMBEDDING_BASE_URL=http://host.docker.internal:11434/v1
EMBEDDING_MODEL=bge-small-en-v1.5
KNOWLEDGE_SEARCH_HNSW_ENABLED=true
KNOWLEDGE_SEARCH_HNSW_MIN_DOCS=32
KNOWLEDGE_SEARCH_HNSW_EF_SEARCH=64
KNOWLEDGE_SEARCH_HNSW_ITERATIVE_SCAN=relaxed_order
